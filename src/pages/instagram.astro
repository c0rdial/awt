---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentNotice from '../components/ContentNotice.astro';
import { Ground, PageTitle } from '../design-system/components';
import { getInstagramPosts, getSettings } from '../lib/sanity';

const [allPosts, settings] = await Promise.all([getInstagramPosts(), getSettings()]);
const posts = allPosts.filter((post) => post.image && post.url);
---
<BaseLayout title="Instagram" ground="instagram" active="Instagram">
  <Ground ground="instagram" className="page instagram">
    <div class="page-inner">
      <PageTitle title="Instagram" subtitle={settings?.instagram} />
      {posts.length ? <div class="instagram__grid">
        {posts.map((post) => <a href={post.url} target="_blank" rel="noopener noreferrer" aria-label={post.alt || 'Open Instagram post'}><img src={post.image} alt={post.alt || ''} loading="lazy" /></a>)}
      </div> : <ContentNotice kind="Instagram posts" />}
    </div>
  </Ground>
</BaseLayout>
